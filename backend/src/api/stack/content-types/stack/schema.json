{
  "kind": "collectionType",
  "collectionName": "stacks",
  "info": {
    "singularName": "stack",
    "pluralName": "stacks",
    "displayName": "Stacks"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "techType": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "frontend_development, backend_architecture, mobile_development, databases_storage, design_branding_ui, devops_infrastructure, multimedia_production"
      ]
    },
    "projects": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::project.project",
      "mappedBy": "stacks"
    },
    "work_experiences": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::work-experience.work-experience",
      "mappedBy": "stacks"
    }
  }
}
